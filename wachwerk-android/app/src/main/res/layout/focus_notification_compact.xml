<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/focus_notification_root"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="#10212E"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="14dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView android:id="@+id/focus_notification_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#F2F6FA" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/focus_notification_round" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="#A8B8C5" android:textSize="11sp" />
    </LinearLayout>

    <Chronometer
        android:id="@+id/focus_notification_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:textColor="#FFFFFF"
        android:textSize="29sp"
        android:textStyle="bold" />
</LinearLayout>
