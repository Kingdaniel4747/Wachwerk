<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/focus_notification_root"
    android:layout_width="match_parent"
    android:layout_height="130dp"
    android:background="#10212E"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp">
    <TextView android:id="@+id/focus_notification_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#F2F6FA" android:textSize="14sp" android:textStyle="bold" />
    <Chronometer android:id="@+id/focus_notification_timer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:fontFamily="sans-serif-medium" android:textColor="#FFFFFF" android:textSize="46sp" android:textStyle="bold" />
    <TextView android:id="@+id/focus_notification_round" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="#A8B8C5" android:textSize="12sp" />
</LinearLayout>
